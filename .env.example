# =============================================================================
# SUPABASE (shared self-hosted ESN Porto instance)
# =============================================================================

# Supabase URL (same instance as IT Manager and the other ESN apps)
NEXT_PUBLIC_SUPABASE_URL=https://supa.esnporto.org

# Anon key. Safe to expose in the browser: every read goes through RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# SERVER ONLY - never expose to the browser, never commit, never bake into the
# Docker image (see .dockerignore). Used by /api/upload (Storage writes) and
# /api/project-config only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================================================
# PROJECT
# =============================================================================

# Must match public.projects.slug (owned by IT Manager) - access checks use it.
NEXT_PUBLIC_PROJECT_SLUG=requisitions_tracker

# Display name shown in the UI / login page
NEXT_PUBLIC_PROJECT_NAME=Requisitions Tracker

# Postgres schema this app reads from (same as the slug)
NEXT_PUBLIC_SUPABASE_SCHEMA=requisitions_tracker

# Public URL of this app. Used for auth redirects and QR code links.
# Local dev: http://localhost:3012 - production: https://requisitions.esnporto.org
NEXT_PUBLIC_APP_URL=http://localhost:3012

# IT Manager URL (linked from the no-access page and the user menu;
# volunteers manage their account and access there)
NEXT_PUBLIC_IT_MANAGER_URL=https://it.esnporto.org

# =============================================================================
# LEGACY FIREBASE - only for scripts/firestore-migration (one-off import).
# Remove after the cutover is complete. SERVER ONLY.
# =============================================================================

# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_ADMIN_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
